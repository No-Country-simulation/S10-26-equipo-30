# Supabase — copiar a .env.local (no commitear secretos reales)
# Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (Route Handlers / Server Actions). No usar NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Resend — correo de confirmación al enviar un desafío (resend.com → API Keys).
# Sin estas dos variables el envío se saltea y el resto del flujo sigue igual.
# Sin dominio verificado usá "No Country <onboarding@resend.dev>": solo llega al correo de tu cuenta de Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: a dónde llegan las respuestas al correo (el texto invita a responderlo).
RESEND_REPLY_TO=
